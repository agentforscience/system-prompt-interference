tions\n    log(f\"{key}: {len(done)} done, {len(todo)} to do, holding {held():.1f} GB\")\n    if not todo:\n        return\n    total = held()\n    kv = cfg[\"kv\"] + max(0.0, total - cfg[\"need\"] - 0.5)\n    RELEASE[\"gb\"] = total\n    llm = LLM(model=cfg[\"hf\"], dtype=\"auto\", max_model_len=2048, gpu_memory_utilization=min(0.95, (total - 0.2) / 47.9),\n              kv_cache_memory_bytes=int(kv * 2**30), enforce_eager=True, max_num_seqs=128,\n              max_num_batched_tokens=2048, seed=SEED, trust_remote_code=False, enable_prefix_caching=False)\n    sps = {\"cls\": SamplingParams(temperature=0.0, max_tokens=12, seed=SEED),\n           \"code\": SamplingParams(temperature=0.0, max_tokens=512, seed=SEED)}\n    t0 = time.time()\n    with open(out, \"a\") as f:\n        for kind in (\"cls\", \"code\"):\n            sub = [p for p in todo if p[\"kind\"] == kind]\n            for i in range(0, len(sub), 1500):\n                ch = sub[i:i + 1500]\n                outs = llm.chat([[{\"role\": \"user\", \"content\": p[\"prompt\"]}] for p in ch], sps[kind], use_tqdm=False,\n                                chat_template_kwargs={\"enable_thinking\": False} if cfg.get(\"thinking_off\") else None)\n                for p, o in zip(ch, outs):\n                    ids = list(o.prompt_token_ids)\n                    f.write(json.dumps(dict(pid=p[\"pid\"], text=o.outputs[0].text, finish=o.outputs[0].finish_reason,\n                                            n_prompt=len(ids), n_out=len(o.outputs[0].token_ids),\n                                            ids_hash=hashlib.sha1(str(ids).encode()).hexdigest()[:16]),\n                                       ensure_ascii=False) + \"\\n\")\n                f.flush()\n                log(f\"{key} {kind} {i + len(ch)}/{len(sub)} {time.time() - t0:.0f}s\")\n    del llm\n    gc.collect()\n\n\ndef main():\n    qfile, max_gb = sys.argv[1], float(sys.argv[2])\n    finished, fails = set(), {}\n    while not (LOGS / \"STOP_workers\").exists():\n        queue = [l.strip() for l in open(qfile) if l.strip() and not l.startswith(\"#\")]\n        ran = False\n        for key in queue:\n            if key in finished or MODELS[key][\"need\"] > max_gb:\n                continue\n            lock = open(GENS / f\"{key}.lock\", \"w\")\n            try:\n                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\n            except OSError:\n                lock.close(); continue                     # another worker has it\n            if not grab(MODELS[key][\"need\"], timeout=30):\n                lock.close(); continue\n            grab(min(max_gb, MODELS[key][\"need\"] + 2), timeout=5)   # a bit of extra KV if it's free\n            before = held()\n            try:\n                run_model(key)\n                finished.add(key)\n            except Exception as e:\n                import traceback; traceback.print_exc(); log(f\"FAILED {key}: {e}\")\n                fails[key] = fails.get(key, 0) + 1\n                if fails[key] >= 3:\n                    finished.add(key)\n            lock.close()\n            try:\n                from vllm.distributed.parallel_state import destroy_model_parallel, destroy_distributed_environment\n                destroy_model_parallel(); destroy_distributed_environment()\n            except Exception as e:\n                log(\"destroy failed\", e)\n            gc.collect()\n            grab(before, timeout=10)                       # re-take the engine's memory from torch's cache\n            log(f\"done {key}; holding {held():.1f} GB\")\n            ran = True\n            break\n        if not ran:\n            remaining = [k for k in queue if k not in finished and MODELS[k][\"need\"] <= max_gb]\n            if not remaining:\n                log(\"queue empty\"); time.sleep(30); continue\n            grab(min(MODELS[k][\"need\"] for k in remaining), timeout=20)\n    log(\"STOP seen; exiting\")\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Model registry. need = GB of GPU memory held for the engine (weights + KV + overhead); kv = KV-cache GB.\"\"\"\nMODELS = {\n    \"qwen2.5-0.5b\": dict(hf=\"Qwen/Qwen2.5-0.5B-Instruct-AWQ\", params=0.5, family=\"qwen2.5\", need=3, kv=1.2),\n    \"qwen2.5-1.5b\": dict(hf=\"Qwen/Qwen2.5-1.5B-Instruct-AWQ\", params=1.5, family=\"qwen2.5\", need=3.5, kv=1.2),\n    \"qwen2.5-3b\":   dict(hf=\"Qwen/Qwen2.5-3B-Instruct-AWQ\", params=3.1, family=\"qwen2.5\", need=4.2, kv=1.0),\n    \"qwen2.5-7b\":   dict(hf=\"Qwen/Qwen2.5-7B-Instruct-AWQ\", params=7.6, family=\"qwen2.5\", need=8, kv=1.4),\n    \"qwen2.5-14b\":  dict(hf=\"Qwen/Qwen2.5-14B-Instruct-AWQ\", params=14.8, family=\"qwen2.5\", need=13, kv=1.5),\n    \"llama3.2-1b\":  dict(hf=\"unsloth/Llama-3.2-1B-Instruct\", params=1.2, family=\"llama3\", need=4.2, kv=1.0),\n    \"llama3.2-3b\":  dict(hf=\"AMead10/Llama-3.2-3B-Instruct-AWQ\", params=3.2, family=\"llama3\", need=4.4, kv=1.0),\n    \"llama3.1-8b\":  dict(hf=\"hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4\", params=8.0, family=\"llama3\",\n                         need=8.5, kv=1.4),\n    \"qwen3-0.6b\":   dict(hf=\"Qwen/Qwen3-0.6B\", params=0.6, family=\"qwen3\", need=3.5, kv=1.0, thinking_off=True),\n    \"qwen3-4b\":     dict(hf=\"Qwen/Qwen3-4B-AWQ\", params=4.0, family=\"qwen3\", need=4.6, kv=0.9, thinking_off=True),\n    # replication run (same checkpoint, separate engine/GPU/batching) - excluded from the main analysis\n    \"rerun-qwen2.5-0.5b\": dict(hf=\"Qwen/Qwen2.5-0.5B-Instruct-AWQ\", params=0.5, family=\"qwen2.5\", need=3, kv=1.2,\n                               replicate=True),\n    # served by the host's long-lived vLLM server (bf16), see src/gen_server.py\n    \"qwen3-8b\":     dict(hf=\"Qwen/Qwen3-8B\", params=8.2, family=\"qwen3\", server=True),\n}\n\"\"\"Generate with the host's long-lived vLLM server (Qwen3-8B, OpenAI-compatible, :8011), greedy, thinking off.\n\nUsage: python src/gen_server.py [N_THREADS]     -> results/gens/qwen3-8b.jsonl (resumable, append-only)\nUses only the standard library.\n\"\"\"\nimport json, os, random, sys, threading, time, urllib.request, fcntl\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nURL = \"http://127.0.0.1:8011/v1/chat/completions\"\nKEY, MODEL = \"qwen3-8b\", \"Qwen3-8B\"\nOUT = ROOT / \"results/gens\" / f\"{KEY}.jsonl\"\nSEED = 42\n\n\ndef call(p):\n    body = dict(model=MODEL, messages=[{\"role\": \"user\", \"content\": p[\"prompt\"]}], temperature=0.0, seed=SEED,\n                max_tokens=12 if p[\"kind\"] == \"cls\" else 512, chat_template_kwargs={\"enable_thinking\": False})\n    for attempt in range(6):\n        try:\n            req = urllib.request.Request(URL, data=json.dumps(body).encode(), headers={\"Content-Type\": \"application/json\"})\n            r = json.load(urllib.request.urlopen(req, timeout=600))\n            c = r[\"choices\"][0]\n            return dict(pid=p[\"pid\"], text=c[\"message\"][\"content\"], finish=c[\"finish_reason\"],\n                        n_prompt=r[\"usage\"][\"prompt_tokens\"], n_out=r[\"usage\"][\"completion_tokens\"], ids_hash=None)\n        except Exception as e:\n            time.sleep(2 ** attempt)\n            err = e\n    print(\"FAILED\", p[\"pid\"], err, flush=True)\n    return None\n\n\ndef main():\n    n_threads = int(sys.argv[1]) if len(sys.argv) > 1 else 48\n    OUT.parent.mkdir(parents=True, exist_ok=True)\n    lock = open(OUT.with_suffix(\".lock\"), \"w\")\n    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)\n    prompts = [json.loads(l) for l in open(ROOT / \"data/prompts.jsonl\")]\n    done = {json.loads(l)[\"pid\"] for l in open(OUT)} if OUT.exists() else set()\n    todo = [p for p in prompts if p[\"pid\"] not in done]\n    random.Random(SEED).shuffle(todo)\n    todo.sort(key=lambda p: p[\"kind\"] != \"cls\")       # short classification prompts first\n    print(f\"{len(done)} done, {len(todo)} to do\", flush=True)\n    wl, t0, n = threading.Lock(), time.time(), 0\n    with open(OUT, \"a\") as f, ThreadPoolExecutor(n_threads) as ex:\n        for res in ex.map(call, todo):\n            if res is None:\n                continue\n            with wl:\n                f.write(json.dumps(res, ensure_ascii=False) + \"\\n\"); f.flush()\n            n += 1\n            if n % 500 == 0:\n                print(f\"{n}/{len(todo)} {time.time() - t0:.0f}s\", flush=True)\n    print(\"DONE\", flush=True)\n\n\nif __name__ == \"__main__\":\n    main()","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HtiXXwXfYkPj3eJz4YAxu2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
